<Window x:Class="Hadaf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hadaf"
        Title="Hadaf" Width="420" Height="760" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Icon="pack://application:,,,/Assets/hadaf.ico"
        UseLayoutRounding="True" FontSize="14" FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            Goal card: 16 padding · 20px check · 12 gap · title line (15, 22.5 high) with the
            countdown pill at its end · one meta row · optional progress / steps.
        -->
        <DataTemplate DataType="{x:Type local:Goal}">
            <Border x:Name="card" Style="{StaticResource CardBox}" Padding="16,14" Margin="0,0,0,8" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Check.Round}" BorderBrush="{Binding PriorityBrush}"
                              VerticalAlignment="Top" Margin="0,1,12,0"
                              IsChecked="{Binding IsChecked, Mode=OneWay}" Click="Done_Click"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="title" Style="{StaticResource T.Subtitle}" Text="{Binding Title}"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,2,0,0" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource SubText}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                        Visibility="{Binding HasWhen, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource T.Icon}" Text="{Binding WhenIcon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding WhenText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CategoryName}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                        Visibility="{Binding IsRecurring, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8EE;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding RepeatText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                        Visibility="{Binding HasStreak, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE735;" FontSize="12" Margin="0,0,6,0"
                                           Foreground="#F59E0B"/>
                                <TextBlock Text="{Binding StreakText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasSubTasks, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE9D5;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ProgressText}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </WrapPanel>
                        <ProgressBar Style="{StaticResource Bar}" Margin="0,12,0,2" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding HasSubTasks, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding SubTasks}" Margin="0,8,0,0"
                                      Visibility="{Binding Expanded, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource Check.Round}" IsChecked="{Binding Done}" Click="Sub_Click" Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top">
                        <Border x:Name="pill" Style="{StaticResource Pill}" Background="{Binding UrgencySoft}"
                                Visibility="{Binding HasPill, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE823;" FontSize="11"
                                           Foreground="{Binding UrgencyBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding PillText}" Foreground="{Binding UrgencyBrush}" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="actions" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,-3,-6,0" Visibility="Hidden">
                            <Button Style="{StaticResource Btn.IconSm}" Content="&#xE9D5;" AutomationProperties.Name="{local:L steps}" Click="Expand_Click"
                                    Visibility="{Binding HasSubTasks, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource Btn.IconSm}" Content="&#xE74D;" AutomationProperties.Name="{local:L delete}" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Faint}"/>
                    <Setter TargetName="card" Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHover}"/>
                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="pill" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Group header: label · count · chevron when collapsible -->
        <DataTemplate DataType="{x:Type local:GroupHeader}">
            <Border x:Name="hdr" Background="Transparent" Padding="4,0" Margin="0,16,0,8" MouseLeftButtonUp="GroupHeader_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ttl" Style="{StaticResource T.Label}" Text="{Binding Title}"/>
                    <TextBlock Style="{StaticResource T.Label}" Text="{Binding CountText}" Foreground="{DynamicResource Faint}"
                               Margin="6,0,0,0" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="chev" Style="{StaticResource T.Icon}" Text="{Binding Chevron}" FontSize="10"
                               Foreground="{DynamicResource Faint}" Margin="6,1,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="hdr" Property="Margin" Value="0,4,0,8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Collapsible}" Value="True">
                    <Setter TargetName="chev" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="hdr" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="overdue">
                    <Setter TargetName="ttl" Property="Foreground" Value="{DynamicResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Menu entry: 16px icon or category dot · label · count -->
        <DataTemplate x:Key="NavTpl">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ic" Style="{StaticResource T.Icon}" Text="{Binding Icon}" Foreground="{DynamicResource SubText}"/>
                <Ellipse x:Name="dot" Width="10" Height="10" Fill="{Binding Brush}" HorizontalAlignment="Left"
                         Margin="3,0,0,0" Visibility="Collapsed"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="count" Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="Normal"
                           VerticalAlignment="Center" Foreground="{DynamicResource Faint}"
                           Visibility="{Binding HasCount, Converter={StaticResource B2V}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCat}" Value="True">
                    <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter TargetName="count" Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="count" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Editable step: 36 high, remove button appears on hover -->
        <DataTemplate x:Key="StepTpl">
            <Grid x:Name="row" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Check.Round}" IsChecked="{Binding Done}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource Input.Bare}" Margin="12,0,8,0"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="remove" Grid.Column="2" Style="{StaticResource Btn.IconSm}" Content="&#xE711;" FontSize="10"
                        Visibility="Hidden" AutomationProperties.Name="{local:L a11y_remove_step}" Click="RemoveStep_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="remove" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TileTpl">
            <Border Style="{StaticResource CardBox}" Margin="0,0,8,8" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource T.Icon}" Text="{Binding Icon}" Foreground="{Binding Brush}" FontSize="12"/>
                        <TextBlock Style="{StaticResource T.Caption}" Text="{Binding Label}" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BarTpl">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource SubText}"/>
                <Grid Height="112" Margin="0,4,0,8">
                    <Border Width="20" Height="{Binding Height}" CornerRadius="6,6,2,2" Background="{Binding Brush}"
                            VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource SubText}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CatRowTpl">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding Pct, Mode=OneWay}"
                             Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource SubText}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" TextElement.Foreground="{DynamicResource Text}">
        <Border Background="{DynamicResource BgLayer}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Title bar: menu flush at the leading edge, window buttons at the other ============ -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MenuBtn" AutomationProperties.Name="{local:L a11y_menu}" Style="{StaticResource Btn.Caption}" Content="&#xE700;" FontSize="16" Click="Menu_Click"/>
                    <Image Source="pack://application:,,,/Assets/hadaf.png" Width="16" Height="16" Margin="4,0,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="{local:L app}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" AutomationProperties.Name="{local:L a11y_minimize}" Click="Min_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource Btn.Caption}" Content="&#xE922;" AutomationProperties.Name="{local:L a11y_maximize}" Click="Max_Click"/>
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" AutomationProperties.Name="{local:L close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ============ Page 1: goals ============ -->
                <Grid x:Name="HomePage" MaxWidth="680">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="20,12,12,0">
                        <Button x:Name="SearchToggle" AutomationProperties.Name="{local:L a11y_search}" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE721;"
                                VerticalAlignment="Top" Margin="0,2,0,0" Click="SearchToggle_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="ViewTitle" Style="{StaticResource T.Display}"/>
                            <TextBlock x:Name="ViewSub" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Notice bar: things the user must know about (recovered data, a save that failed) -->
                        <Border x:Name="Notice" Margin="20,12,20,0" Padding="14,12,8,12" CornerRadius="{StaticResource R.Card}"
                                BorderThickness="1" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="NoticeIcon" DockPanel.Dock="Left" Style="{StaticResource T.Icon}" Text="&#xE7BA;"
                                           VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.IconSm}" Content="&#xE711;" FontSize="10"
                                        VerticalAlignment="Top" Margin="8,-4,0,0" AutomationProperties.Name="{local:L a11y_dismiss}" Click="NoticeClose_Click"/>
                                <StackPanel>
                                    <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NoticeText" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <Button x:Name="NoticeAction" Style="{StaticResource Btn}" Height="32" Padding="12,0" FontSize="13"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="NoticeAction_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="SearchRow" Margin="20,12,20,0" Visibility="Collapsed">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="{local:L search}" Padding="36,0,12,0"
                                     TextChanged="Search_TextChanged"/>
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource Faint}"
                                       HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <ItemsControl x:Name="GoalList" Focusable="False"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Style="{StaticResource Scroll}" CanContentScroll="True" Padding="20,0,20,12">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="260" Margin="0,0,0,48" Visibility="Collapsed">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="EmptyIcon" Style="{StaticResource T.Icon}" Text="&#xE7C1;" FontSize="26"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource T.Subtitle}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,4"/>
                            <TextBlock x:Name="EmptySub" Style="{StaticResource T.Caption}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer x:Name="StatsView" Style="{StaticResource Scroll}" Padding="20,0,20,16" Visibility="Collapsed">
                            <StackPanel>
                                <ItemsControl x:Name="Tiles" ItemTemplate="{StaticResource TileTpl}" Margin="0,4,-8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource T.Label}" Text="{local:L s_last7}" Margin="4,16,4,8"/>
                                <Border Style="{StaticResource CardBox}" Padding="16">
                                    <ItemsControl x:Name="Bars" ItemTemplate="{StaticResource BarTpl}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Style="{StaticResource T.Label}" Text="{local:L s_bycat}" Margin="4,24,4,8"/>
                                <Border Style="{StaticResource CardBox}" Padding="16,6">
                                    <ItemsControl x:Name="CatStats" ItemTemplate="{StaticResource CatRowTpl}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Composer: Enter adds straight away; the round button opens the full editor -->
                    <Grid x:Name="Composer" Grid.Row="3" Margin="20,4,20,16">
                        <TextBox x:Name="QuickAdd" Style="{StaticResource Input.Composer}" KeyDown="QuickAdd_KeyDown"/>
                        <Button Style="{StaticResource Btn.Primary}" Width="32" Height="32" Padding="0" local:UI.Radius="16"
                                HorizontalAlignment="Right" Margin="0,0,6,0" FontFamily="{StaticResource Icons}" FontSize="14"
                                Content="&#xE710;" AutomationProperties.Name="{local:L a11y_add}" Click="ComposerOpen_Click"/>
                    </Grid>
                </Grid>

                <!-- ============ Page 2: goal editor ============ -->
                <Grid x:Name="EditorPage" MaxWidth="680" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="12,6,20,6">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="14"
                                AutomationProperties.Name="{local:L cancel}" Click="CloseEditor_Click"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="{local:L save}"
                                Padding="20,0" Click="Save_Click"/>
                        <TextBlock x:Name="EditorTitle" Style="{StaticResource T.Subtitle}" Margin="8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Style="{StaticResource Scroll}" Padding="20,8,20,24">
                        <StackPanel x:Name="EditorForm">
                            <TextBox x:Name="TitleBox" Style="{StaticResource Input.Bare}" Tag="{local:L title_ph}"
                                     FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource Input.Bare}" Tag="{local:L notes_ph}" Margin="0,4,0,0"
                                     Foreground="{DynamicResource SubText}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Details -->
                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_details}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L category}" Margin="0,0,0,8"/>
                                    <ListBox x:Name="CatChips" Style="{StaticResource Chips}" Margin="0,0,0,-8"
                                             SelectedValue="{Binding Category}"/>
                                    <Border Style="{StaticResource Rule}" Margin="-16,16"/>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L priority}" Margin="0,0,0,8"/>
                                    <ListBox x:Name="PrioChips" Style="{StaticResource Segmented}"
                                             SelectedValue="{Binding Priority}"/>
                                </StackPanel>
                            </Border>

                            <!-- Schedule & repeat: choose the repeat first, then only what that repeat needs -->
                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_schedule}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DueIcon" Style="{StaticResource T.Icon}" Text="&#xE787;"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="DueSummary" Style="{StaticResource T.Subtitle}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L recurrence}" Margin="0,16,0,8"/>
                                    <ListBox x:Name="RecChips" Style="{StaticResource Segmented}"
                                             SelectedValue="{Binding Recurrence}" SelectionChanged="Repeat_Changed"/>

                                    <!-- One-off, weekly, monthly: pick a date -->
                                    <StackPanel x:Name="DatePanel">
                                        <Border Style="{StaticResource Rule}" Margin="-16,16"/>
                                        <WrapPanel Margin="0,0,0,-8">
                                            <Button Style="{StaticResource Btn.Chip}" Tag="0" Content="{local:L today}" Click="QuickDate_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="1" Content="{local:L tomorrow}" Click="QuickDate_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="7" Content="{local:L next_week}" Click="QuickDate_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="none" Content="{local:L no_deadline}" Click="QuickDate_Click"/>
                                        </WrapPanel>
                                        <StackPanel x:Name="CalendarPanel" HorizontalAlignment="Center" Margin="0,16,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <Button x:Name="CalPrev" AutomationProperties.Name="{local:L a11y_prev_month}" DockPanel.Dock="Left" Style="{StaticResource Btn.IconSm}"
                                                        FontSize="11" Click="CalPrev_Click"/>
                                                <Button x:Name="CalNext" AutomationProperties.Name="{local:L a11y_next_month}" DockPanel.Dock="Right" Style="{StaticResource Btn.IconSm}"
                                                        FontSize="11" Click="CalNext_Click"/>
                                                <TextBlock x:Name="CalTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <UniformGrid x:Name="CalHead" Columns="7"/>
                                            <UniformGrid x:Name="CalDays" Columns="7" Rows="6"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Daily: which weekdays, and whether it has a set time -->
                                    <StackPanel x:Name="DailyPanel">
                                        <Border Style="{StaticResource Rule}" Margin="-16,16"/>
                                        <TextBlock Style="{StaticResource T.Caption}" Text="{local:L days}" Margin="0,0,0,8"/>
                                        <UniformGrid x:Name="DaysRow" Columns="7" HorizontalAlignment="Center"/>
                                        <ListBox x:Name="TimeModeChips" Style="{StaticResource Segmented}" Margin="0,16,0,0"
                                                 SelectedValue="{Binding AnyTime}" SelectionChanged="TimeMode_Changed"/>
                                    </StackPanel>

                                    <!-- Time and reminder: only when there is a time to keep -->
                                    <StackPanel x:Name="TimePanel">
                                        <Border Style="{StaticResource Rule}" Margin="-16,16"/>
                                        <DockPanel>
                                            <TextBox x:Name="TimeBox" DockPanel.Dock="Right" Style="{StaticResource Input}" Width="88"
                                                     Tag="18:00" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"
                                                     TextChanged="TimeBox_TextChanged"/>
                                            <TextBlock Style="{StaticResource T.Caption}" Text="{local:L time}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,12,0,-8">
                                            <Button Style="{StaticResource Btn.Chip}" Tag="09:00" Content="09:00" Click="QuickTime_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="12:00" Content="12:00" Click="QuickTime_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="18:00" Content="18:00" Click="QuickTime_Click"/>
                                            <Button Style="{StaticResource Btn.Chip}" Tag="23:59" Content="23:59" Click="QuickTime_Click"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource T.Caption}" Text="{local:L remind_before}" Margin="0,16,0,8"/>
                                        <ListBox x:Name="RemChips" Style="{StaticResource Segmented}"
                                                 SelectedValue="{Binding RemindMinutes}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Steps -->
                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L steps}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16,6">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SubTasks}" ItemTemplate="{StaticResource StepTpl}"/>
                                    <Grid Height="36">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE710;" FontSize="14" Width="20"
                                                   TextAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}"/>
                                        <TextBox x:Name="NewStepBox" Style="{StaticResource Input.Bare}" Tag="{local:L add_step_ph}"
                                                 Margin="32,0,0,0" KeyDown="NewStep_KeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="DeleteBtn" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Center"
                                    Margin="0,24,0,0" Click="EditorDelete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{local:L delete_goal}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============ Page 3: settings ============ -->
                <Grid x:Name="SettingsPage" MaxWidth="680" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="12,6,20,6">
                        <Button x:Name="SettingsBack" AutomationProperties.Name="{local:L a11y_back}" DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" FontSize="14"
                                Click="SettingsBack_Click"/>
                        <TextBlock Style="{StaticResource T.Subtitle}" Text="{local:L settings}" Margin="8,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource Scroll}" Padding="20,8,20,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_appearance}" Margin="4,0,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_theme}" Margin="0,0,0,8"/>
                                    <ListBox x:Name="ThemeChips" Style="{StaticResource Segmented}" SelectionChanged="SettingChip_Changed"/>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_effect}" Margin="0,16,0,8"/>
                                    <ListBox x:Name="FxChips" Style="{StaticResource Segmented}" SelectionChanged="SettingChip_Changed"/>
                                    <TextBlock Text="{local:L fx_desc}" FontSize="12" Foreground="{DynamicResource Faint}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="GlassNote" Text="{local:L glass_unsupported}" FontSize="12"
                                               Foreground="{DynamicResource Danger}" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    <Border Style="{StaticResource Rule}" Margin="-16,16"/>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_opacity}"/>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource Slider}" Minimum="0" Maximum="1"
                                            Margin="0,4,0,0" ValueChanged="Opacity_Changed"/>
                                    <TextBlock Text="{local:L set_opacity_hint}" FontSize="12" Foreground="{DynamicResource Faint}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_language}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16">
                                <ListBox x:Name="LangChips" Style="{StaticResource Segmented}" SelectionChanged="SettingChip_Changed"/>
                            </Border>

                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_notify}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16,0">
                                <StackPanel>
                                    <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Margin="0,14" Click="Switch_Click">
                                        <StackPanel>
                                            <TextBlock Text="{local:L set_notify}"/>
                                            <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_notify_desc}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Rule}" Margin="-16,0"/>
                                    <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" Margin="0,14" Click="Switch_Click">
                                        <StackPanel>
                                            <TextBlock Text="{local:L set_tray}"/>
                                            <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_tray_desc}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Rule}" Margin="-16,0"/>
                                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Margin="0,14" Click="Switch_Click">
                                        <StackPanel>
                                            <TextBlock Text="{local:L set_startup}"/>
                                            <TextBlock Style="{StaticResource T.Caption}" Text="{local:L set_startup_desc}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource T.Label}" Text="{local:L sec_data}" Margin="4,24,4,8"/>
                            <Border Style="{StaticResource CardBox}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource T.Caption}" Text="{local:L data_desc}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BackupInfo" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource Btn}" Content="{local:L backup_now}" Margin="0,0,8,0"
                                                Click="BackupNow_Click"/>
                                        <Button Style="{StaticResource Btn.Subtle}" Content="{local:L open_data_folder}"
                                                Click="OpenDataFolder_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{local:L about}" FontSize="12" Foreground="{DynamicResource Faint}"
                                       HorizontalAlignment="Center" Margin="0,24,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Menu: floating sheet from the leading edge ============ -->
        <Grid x:Name="DrawerOverlay" Margin="0,40,0,0" Visibility="Collapsed">
            <Border x:Name="DrawerScrim" Background="{DynamicResource Scrim}" MouseLeftButtonDown="DrawerScrim_MouseDown"/>
            <Grid x:Name="Drawer" Width="288" HorizontalAlignment="Left" Margin="8,4,0,8">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift"/>
                </Grid.RenderTransform>
                <Border CornerRadius="{StaticResource R.Overlay}" Background="{DynamicResource Surface}"
                        Effect="{DynamicResource ShadowLg}" x:Name="DrawerShadow"/>
                <Border CornerRadius="{StaticResource R.Overlay}" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                            <Image Source="pack://application:,,,/Assets/hadaf.png" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.Title}" Text="{local:L app}"/>
                                <TextBlock x:Name="DrawerSummary" Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Style="{StaticResource Rule}"/>
                            <DockPanel Margin="8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE706;"
                                        AutomationProperties.Name="{local:L a11y_theme}" Click="ThemeToggle_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Subtle}" Padding="10,0" FontSize="13"
                                        Foreground="{DynamicResource SubText}" Content="{local:L lang_switch}" Click="Lang_Click"/>
                                <Button Style="{StaticResource Btn.Subtle}" Height="40" HorizontalContentAlignment="Left"
                                        Padding="12,0" Click="Settings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE713;" Width="28" Foreground="{DynamicResource SubText}"/>
                                        <TextBlock Text="{local:L settings}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </StackPanel>

                        <ScrollViewer Style="{StaticResource Scroll}" Padding="8,0,8,8">
                            <StackPanel>
                                <ListBox x:Name="NavList" Style="{StaticResource NavList}" ItemTemplate="{StaticResource NavTpl}"
                                         SelectionChanged="Nav_SelectionChanged"/>
                                <TextBlock Style="{StaticResource T.Label}" Text="{local:L categories}" Margin="12,16,12,8"/>
                                <ListBox x:Name="CatList" Style="{StaticResource NavList}" ItemTemplate="{StaticResource NavTpl}"
                                         SelectionChanged="Cat_SelectionChanged"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Snackbar: floats above the composer ============ -->
        <Grid x:Name="Snack" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="20,0,20,76" MaxWidth="440">
            <Border CornerRadius="{StaticResource R.Card}" Background="{DynamicResource Surface}" Effect="{DynamicResource ShadowSm}"/>
            <Border CornerRadius="{StaticResource R.Card}" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="16,6,6,6" MinHeight="44">
                <DockPanel>
                    <Button x:Name="SnackAction" DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Margin="12,0,0,0"
                            Click="SnackAction_Click"/>
                    <TextBlock x:Name="SnackText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
