<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Hadaf">

    <!--
        Design system
        Spacing  4-pt grid. Page gutter 20, card padding 16, list gap 8, section gap 24.
        Radius   8 controls · 12 cards and 44px fields · 16 floating layers · full for pills.
        Height   36 controls · 32 chips and segments · 44 composer.
        Type     IBM Plex Sans Arabic (natural line height 1.5em):
                 24 display · 17 title · 15 subtitle · 14 body · 13 caption · 12 label.
        Depth    page (none) · card (hairline, darker bottom edge) · floating (shadow).
    -->

    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#IBM Plex Sans Arabic, Segoe UI</FontFamily>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <!-- Keyboard focus: an accent ring, shown only when moving with the keyboard (never on mouse clicks) -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CardFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Overlay">16</CornerRadius>

    <!-- Colour tokens: placeholders, replaced at runtime by Theme.Apply -->
    <SolidColorBrush x:Key="BgLayer" Color="#8516161A"/>
    <SolidColorBrush x:Key="Card" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ControlFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrong" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Track" Color="#33000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="InputHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InputFocus" Color="#33000000"/>
    <SolidColorBrush x:Key="InputStroke" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Pressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Selected" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="SubText" Color="#BFC1CA"/>
    <SolidColorBrush x:Key="Faint" Color="#8B8E9A"/>
    <SolidColorBrush x:Key="Surface" Color="#F7232328"/>
    <SolidColorBrush x:Key="Scrim" Color="#59000000"/>
    <SolidColorBrush x:Key="Accent" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EA78BFA"/>
    <SolidColorBrush x:Key="InfoStroke" Color="#52A78BFA"/>
    <SolidColorBrush x:Key="AccentText" Color="#14161F"/>
    <SolidColorBrush x:Key="Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26F87171"/>
    <SolidColorBrush x:Key="DangerStroke" Color="#47F87171"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#24FBBF24"/>
    <SolidColorBrush x:Key="WarnStroke" Color="#47FBBF24"/>
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" Color="Black"/>

    <!-- ===================== Type ===================== -->
    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="T.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
    </Style>
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="CardBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}"/>
    </Style>
    <Style x:Key="Rule" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Divider}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="11"/>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <ControlTemplate x:Key="ButtonTpl" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding (local:UI.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="ov" Background="{DynamicResource Hover}" Opacity="0"
                    CornerRadius="{Binding (local:UI.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ov" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ov" Property="Background" Value="{DynamicResource Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Standard: 36 high, raised fill with hairline -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonTpl}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="local:UI.Radius" Value="{StaticResource R.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Btn.Subtle" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
    </Style>

    <Style x:Key="Btn.IconSm" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="local:UI.Radius" Value="6"/>
    </Style>

    <!-- Quick picks (dates, times): pill, 32 high -->
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="local:UI.Radius" Value="16"/>
    </Style>

    <!-- Calendar day: 36 circle -->
    <Style x:Key="Btn.Day" TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="local:UI.Radius" Value="18"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="other">
                <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            </Trigger>
            <Trigger Property="Tag" Value="today">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="Tag" Value="sel">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window chrome: 46 x 40, flush with the title bar -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Text inputs ===================== -->
    <!-- 36 high; hairline with a stronger bottom edge; accent underline on focus -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="local:UI.Radius" Value="{StaticResource R.Control}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding (local:UI.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="focusLine" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2"
                                Visibility="Collapsed"
                                CornerRadius="{Binding (local:UI.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Faint}" Visibility="Collapsed" IsHitTestVisible="False"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputFocus}"/>
                            <Setter TargetName="focusLine" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom composer: 44 high, radius 12, room for the round button at the end -->
    <Style x:Key="Input.Composer" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,0,48,0"/>
        <Setter Property="local:UI.Radius" Value="{StaticResource R.Card}"/>
    </Style>

    <!-- Borderless text (editor title, notes, step names) -->
    <Style x:Key="Input.Bare" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource Faint}" Visibility="Collapsed" IsHitTestVisible="False"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Toggles ===================== -->
    <!-- 20px completion circle; ring colour comes from BorderBrush (priority) -->
    <Style x:Key="Check.Round" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Faint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Top">
                            <Ellipse x:Name="ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter x:Name="cp" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Hover}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource AccentText}"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="cp" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 40 x 20 switch, label at the start -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="track" DockPanel.Dock="Right" Width="40" Height="20" CornerRadius="10"
                                Background="Transparent" BorderBrush="{DynamicResource SubText}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource SubText}"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Width" Value="14"/>
                            <Setter TargetName="knob" Property="Height" Value="14"/>
                            <Setter TargetName="knob" Property="Margin" Value="3,0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Weekday picker: 36px circle per day, filled when the task runs that day -->
    <Style x:Key="DayToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Ellipse x:Name="bg" Fill="{DynamicResource ControlFill}" Stroke="{DynamicResource ControlStroke}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="bg" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Pickers ===================== -->
    <DataTemplate x:Key="OptTpl">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                <Setter TargetName="dot" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Segmented control: one 36px track, equal segments, the selected one raised -->
    <Style x:Key="SegItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlStrong}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegItem}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource OptTpl}"/>
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{DynamicResource Track}" BorderBrush="{DynamicResource CardStroke}"
                            BorderThickness="1" CornerRadius="{StaticResource R.Control}" Padding="2">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chips: wrapping pills, 32 high -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="16" Padding="14,0" Background="{DynamicResource ControlFill}"
                            BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chips" TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource OptTpl}"/>
        <Setter Property="SelectedValuePath" Value="Key"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu entries: 40 high, accent bar marks the current one -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="{StaticResource R.Control}" Background="Transparent"/>
                        <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" Visibility="Hidden"/>
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox" BasedOn="{StaticResource Chips}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scrolling ===================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="{DynamicResource Faint}" Opacity="0.6"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource Faint}" Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Overlay scrolling: the bar floats in the page gutter and only shows on hover, so content keeps symmetric margins -->
    <Style x:Key="Scroll" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="Transparent">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,4,6,4"
                                   Opacity="0.35" Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Range ===================== -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Divider}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderBlank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="32" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Divider}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderBlank}" Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource Surface}" Stroke="{DynamicResource ControlStroke}" StrokeThickness="1"/>
                                                <Ellipse x:Name="dot" Width="12" Height="12" Fill="{DynamicResource Accent}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dot" Property="Width" Value="14"/>
                                                    <Setter TargetName="dot" Property="Height" Value="14"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="dot" Property="Width" Value="10"/>
                                                    <Setter TargetName="dot" Property="Height" Value="10"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Right-click menu ===================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FlowDirection" Value="{Binding PlacementTarget.FlowDirection, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Card}" Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" CornerRadius="{StaticResource R.Control}" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus style their separators through this key, never through an implicit Separator style -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Divider}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
