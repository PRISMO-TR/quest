<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Hadaf</RootNamespace>
    <AssemblyName>Hadaf</AssemblyName>
    <AssemblyTitle>Hadaf</AssemblyTitle>
    <Product>Hadaf</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\hadaf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- keep the footprint small -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\hadaf.ico" />
    <Resource Include="Assets\hadaf.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
